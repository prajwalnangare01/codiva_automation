            "index": 0
          }
        ]
      ]
    },
    "Is TEST_MODE Active?": {
      "main": [
        [
          {
            "node": "Simulated Test Mode Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Instagram Create Media Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram Create Media Container": {
      "main": [
        [
          {
