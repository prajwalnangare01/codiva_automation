# Codiva Autonomous Instagram Publisher Environment Template
# Add these 3 as Secrets in your GitHub Repository Settings (Settings > Secrets and variables > Actions):

# 1. Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta/Instagram Graph API User Access Token (Page access token with instagram_content_publish)
IG_ACCESS_TOKEN=your_facebook_graph_access_token_here

# 3. Instagram Business Account ID for @codiva_labs
IG_ACCOUNT_ID=17841475951559107

# Optional FreeImageHost API Key (Default embedded fallback provided)
FREEIMAGEHOST_KEY=6d207e02198a847aa98d0a2a901485a5

# Set to true for local testing without actually publishing live
DRY_RUN=false
